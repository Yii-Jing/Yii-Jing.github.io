---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign indexed_pages = '/,/blogs/,/publications/,/honors/' | split: ',' %}
  {% for path in indexed_pages %}
  <url><loc>{{ path | absolute_url | xml_escape }}</loc></url>
  {% endfor %}
  {% for post in site.posts %}
  <url><loc>{{ post.url | absolute_url | xml_escape }}</loc>{% if post.last_modified_at %}<lastmod>{{ post.last_modified_at | date_to_xmlschema }}</lastmod>{% endif %}</url>
  {% endfor %}
  {% for paper in site.publications %}
  <url><loc>{{ paper.url | absolute_url | xml_escape }}</loc>{% if paper.last_modified_at %}<lastmod>{{ paper.last_modified_at | date_to_xmlschema }}</lastmod>{% endif %}</url>
  {% endfor %}
</urlset>
